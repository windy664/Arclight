    "server.MainMixin",
    "server.MinecraftServerMixin",
    "server.PlayerAdvancementsMixin",
    "server.ServerAdvancementManagerMixin",
    "server.ServerFunctionManagerMixin",
    "server.ServerScoreboardMixin",
    "server.ServerTickRateManagerMixin",
